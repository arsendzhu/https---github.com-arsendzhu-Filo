# Copy to .env and fill in what you have. Never commit .env.
#   cp .env.example .env && chmod 600 .env
# Filo picks the provider automatically: Claude if ANTHROPIC_API_KEY is set,
# otherwise NVIDIA NIM if NVIDIA_API_KEY is set, otherwise notes-only answers.

ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# Optional overrides
# FILO_PROVIDER=nim            # auto | anthropic | nim
# FILO_MODEL=claude-opus-5     # Claude model
# FILO_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Research agent (NVIDIA NIM tool calling) — models, timeouts and limits live under "research" in
# config.json (see config.example.json); there is no env override for the model chain on purpose.
